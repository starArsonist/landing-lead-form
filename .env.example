# Скопируйте в .env и задайте значения. Без них проект работает в режиме разработки.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Необязательно: уведомления о заявках в Telegram. Если не задано, заявки просто сохраняются.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Сколько заявок с одного IP принимать за час.
LEADS_RATE_LIMIT_PER_HOUR=5
